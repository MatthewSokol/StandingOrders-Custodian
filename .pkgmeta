# For CurseForge's automatic packager (BigWigs packager), if the GitHub repo is ever linked to the
# CurseForge project. The manual path is release.ps1 (see RELEASING.md). The addon lives in Faves/.
package-as: Faves

move-folders:
  Faves/Faves: Faves

ignore:
  - tools
  - docs
  - dist
  - CLAUDE.md
  - RELEASING.md
  - TESTING.md
  - README.md
  - install.ps1
  - release.ps1
  - .luacheckrc

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
